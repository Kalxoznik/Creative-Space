{
  "name": "creative-space",
  "version": "0.1.0",
  "description": "A local kanban board where you, an Architect agent and a Coder agent work on a project together",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kalxoznik/Creative-Space.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "up": "node scripts/up.mjs",
    "build": "next build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/ts-imports.mjs --test \"agents/*.test.mjs\" \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "worker": "node agents/worker.mjs",
    "worker:live": "CS_AGENT_MODE=live node agents/worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
